{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "riddle-letters-v3-preview",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "riddle-letters-v3-preview",
      "database_id": "1b50f812-b419-4b49-b24f-aab9f309f73d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "riddle-letters-v3-preview-media"
    }
  ],
  "services": [
    {
      "binding": "IMAGE_TRANSFORMER",
      "service": "riddle-letters-v3-image-transformer"
    }
  ]
}
