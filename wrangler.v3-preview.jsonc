{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "riddle-letters-v3-preview",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "riddle-letters-v3-business-preview",
      "database_id": "3bb2d39b-8ddd-447b-982c-997d5ed399d7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "riddle-letters-v3-preview-media"
    }
  ],
  "services": [
    {
      "binding": "IMAGE_TRANSFORMER",
      "service": "riddle-letters-v3-image-transformer"
    }
  ]
}
